{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "6a5fbbe6fe8c0de669dd99e1",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": [
      {
        "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*"
        ]
      }
    ],
    "test": [
      {
        "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ],
    "e2e": {
      "cache": true
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "analytics": true,
  "migrate": {
    "agentic": true
  },
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "packages/dom/**/*",
        "packages/html/**/*",
        "packages/markdown/**/*",
        "packages/react/**/*",
        "packages/slate-serializers/**/*",
        "packages/template/**/*",
        "packages/tests/**/*",
        "packages/utilities/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "packages/dom/**/*",
        "packages/html/**/*",
        "packages/markdown/**/*",
        "packages/react/**/*",
        "packages/slate-serializers/**/*",
        "packages/template/**/*",
        "packages/tests/**/*",
        "packages/utilities/**/*"
      ]
    }
  ]
}
