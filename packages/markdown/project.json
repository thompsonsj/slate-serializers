{
  "name": "markdown",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/markdown/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/markdown",
        "main": "packages/markdown/src/index.ts",
        "tsConfig": "packages/markdown/tsconfig.lib.json",
        "assets": ["packages/markdown/*.md"],
        "updateBuildableProjectDepsInPackageJson": true,
        "buildableProjectDepsInPackageJsonType": "dependencies"
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs markdown {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/markdown/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "distFolderPath": "dist/packages/markdown",
        "access": "public"
      },
      "dependsOn": ["build"]
    }
  }
}
