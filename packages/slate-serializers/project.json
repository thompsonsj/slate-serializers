{
  "name": "slate-serializers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/slate-serializers/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/slate-serializers",
        "main": "packages/slate-serializers/src/index.ts",
        "tsConfig": "packages/slate-serializers/tsconfig.lib.json",
        "assets": ["packages/slate-serializers/*.md"],
        "updateBuildableProjectDepsInPackageJson": true,
        "buildableProjectDepsInPackageJsonType": "dependencies"
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs slate-serializers {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "dependsOn": ["build"],
      "options": {
        "distFolderPath": "dist/packages/slate-serializers",
        "access": "public"
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "conventional"
      }
    }
  }
}
